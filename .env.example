# IntelliDocs Environment Settings
SECRET_KEY=intellidocs_default_secret_key_change_in_production_9f8e7d6c5b4a
DATABASE_URL=sqlite:///./data/intellidocs.db
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=50
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Security / Hashing
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# Feature Flags
ENABLE_SEMANTIC_SEARCH=true
ENABLE_ZERO_SHOT_CLASSIFIER=false
ENABLE_SUMMARIZER=false

# CORS & Logging
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000
